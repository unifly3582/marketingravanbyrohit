[Unit]
Description=Marketing Ravan call-request API (Sarvam instant outbound)
After=network.target

[Service]
Type=simple
WorkingDirectory=/var/www/marketingravan/server
EnvironmentFile=/etc/marketingravan.env
ExecStart=/usr/bin/node /var/www/marketingravan/server/index.mjs
Restart=always
RestartSec=3
User=www-data
Group=www-data

[Install]
WantedBy=multi-user.target
